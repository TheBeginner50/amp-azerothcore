Meta.DisplayName=AzerothCore WoW
Meta.Description=AzerothCore 3.3.5a WoW Server Stack
Meta.Arch=x86_64
Meta.Author=TheBeginner
Meta.URL=https://www.azerothcore.org
Meta.MinAMPVersion=2.4.6.6
Meta.DockerRequired=False
Meta.ContainerPolicy=Supported
Meta.AppConfigId=d5057bde-27be-41d2-a53c-79d4e74bb017
Meta.OS=2
Meta.DisplayImageSource=url:https://www.azerothcore.org/images/logo.png
Meta.ConfigManifest=azerothcore-wowconfig.json
Meta.MetaConfigManifest=azerothcore-wowmetaconfig.json
Meta.ConfigRoot=azerothcore-wow.kvp

App.DisplayName=AzerothCore WoW
App.RootDir=/opt/azerothcore/azerothcore-wotlk
App.BaseDirectory=/opt/azerothcore/azerothcore-wotlk
App.WorkingDir=/opt/azerothcore/azerothcore-wotlk
App.ExecutableLinux=/usr/bin/docker
App.LinuxCommandLineArgs=compose -f /opt/azerothcore/azerothcore-wotlk/docker-compose.yml up
App.CommandLineArgs={{$PlatformArgs}} {{$FormattedArgs}}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter= 
App.RapidStartup=false
App.ApplicationReadyMode=Immediate
App.ExitMethod=OS_CLOSE
App.ExitString=stop
App.ExitTimeout=30
App.ApplicationIPBinding=0.0.0.0
App.AdminMethod=PinballWizard
App.HasReadableConsole=false
App.HasWritableConsole=false
App.Ports=@IncludeJson[azerothcore-wowports.json]
App.UpdateSources=@IncludeJson[azerothcore-wowupdates.json]
